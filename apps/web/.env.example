VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Used by the production server-rendered SEO shell. Set to the externally
# reachable API URL when deploying Public Web as its own service.
PLATFORM_API_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:3000
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Required for production password auth; may be left empty only for local development.
# Supported values: turnstile | hcaptcha | empty (local dev only).
VITE_CAPTCHA_PROVIDER=
VITE_CAPTCHA_SITE_KEY=
